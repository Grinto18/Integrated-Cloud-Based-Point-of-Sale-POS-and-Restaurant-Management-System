# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Server & Security (in production, supply a stable >=32-byte random secret via Cloud Run Secret Manager)
PORT=3000
# Generate with: openssl rand -hex 48
JWT_SECRET="REPLACE_WITH_MIN_32_BYTE_CSPRNG_SECRET"
# Optional mounted secret path when using Google Secret Manager volume mounts on Cloud Run:
# JWT_SECRET_FILE="/secrets/jwt_secret"

# Database Configuration (PostgreSQL)
SQL_HOST="127.0.0.1"
SQL_PORT=5432
SQL_USER="postgres"
SQL_PASSWORD="password"
SQL_DB_NAME="grine_pos"

# Windows 7 Node.js Compatibility (Set this in Windows environment variables):
# NODE_SKIP_PLATFORM_CHECK=1

# Windows Thermal Printer Setup
DEFAULT_PRINTER_NAME="CAFETERIA"
DEFAULT_PRINTER_DRIVER="80Normal"
